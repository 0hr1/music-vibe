# Host port the app is served on.
PORT=8420
# Let anyone register without an invite code. The very first account can always register;
# after that, new accounts need an invite code made on the Admin page (Account > Invite codes & users).
ALLOW_SIGNUP=false
# Who can make invite codes and manage users, comma-separated. Empty: the first account.
ADMIN_USERNAMES=
# Contact info sent to MusicBrainz in the User-Agent (they ask for one). An email or URL.
MB_CONTACT=
# Set to true once served over HTTPS (makes the session cookie secure-only).
HTTPS_ONLY=false
# Optional; if empty a key is generated and stored in data/secret_key.
SECRET_KEY=
# Optional; lets the app find Spotify links automatically. From developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# How many daily database snapshots to keep in data/backups.
BACKUP_KEEP=14
# Optional; continuously back up the database to S3-compatible storage with Litestream.
# e.g. s3://<bucket>/music_vibe.db?endpoint=fly.storage.tigris.dev&region=auto
# (credentials come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
LITESTREAM_REPLICA_URL=
