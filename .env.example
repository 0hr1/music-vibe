# Host port the app is served on.
PORT=8420
# Allow new accounts to register. The very first account can always register.
ALLOW_SIGNUP=false
# Contact info sent to MusicBrainz in the User-Agent (they ask for one). An email or URL.
MB_CONTACT=
# Set to true once served over HTTPS (makes the session cookie secure-only).
HTTPS_ONLY=false
# Optional; if empty a key is generated and stored in data/secret_key.
SECRET_KEY=
# Optional; lets the app find Spotify links automatically. From developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
